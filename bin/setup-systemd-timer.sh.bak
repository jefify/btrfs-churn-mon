#!/usr/bin/env bash

set -euo pipefail

PREFIX="${PREFIX:-/opt/btrfs-churn-mon}"

mkdir -p "$PREFIX"

install -m 644 \
    "$(dirname "$0")/../systemd/btrfs-churn-mon.service" \
    /etc/systemd/system/

install -m 644 \
    "$(dirname "$0")/../systemd/btrfs-churn-mon.timer" \
    /etc/systemd/system/

systemctl daemon-reload

systemctl enable btrfs-churn-mon.timer

systemctl start btrfs-churn-mon.timer

echo
echo "Installed."
