# btrfs-exclude-path.sh — Configuration
#
# Copy to: /opt/btrfs-churn-mon/etc/btrfs-exclude-path.conf
#
# All values can be overridden via command-line flags.
# Lines starting with # are comments. Empty values = disabled.

# --------------------------------------------------------------------------
# DEVICE — Btrfs device path
# --------------------------------------------------------------------------
# The block device containing the btrfs filesystem.
# Supports /dev/disk/by-id/... paths for stability across reboots
# (avoids issues with device reordering in the same volume group).
# If empty, auto-detected from the target path via df.
#
# Examples:
#   DEVICE=/dev/dm-0
#   DEVICE=/dev/disk/by-id/dm-uuid-LVM-BXg1fR307zkYtyLLT22Fg1ic4psQ3d7Rg5gzobZHSZQ2wlAR20QfmeZh8hvxCmB3
#
# DEVICE=

# --------------------------------------------------------------------------
# SUBVOL_PREFIX — Prefix for subvolume names inside btrfs top-level
# --------------------------------------------------------------------------
# Controls where the new subvolume is created inside btrfs subvolid=5.
# Can contain '/' for subdirectories and '@' as name prefix.
# Intermediate directories are created automatically (mkdir -p).
#
# Examples:
#   (empty)            /var/cache → subvol: var_cache
#   SUBVOL_PREFIX=nosnap    /var/cache → subvol: nosnap/var_cache
#   SUBVOL_PREFIX=no_snap/@ /var/cache → subvol: no_snap/@var_cache
#   SUBVOL_PREFIX=excl/     /var/cache → subvol: excl/var_cache
#
# SUBVOL_PREFIX=

# --------------------------------------------------------------------------
# SYSTEMD_UNIT_PREFIX — Prefix for systemd .mount unit filenames
# --------------------------------------------------------------------------
# Prepended to the generated unit filename. Useful for grouping all
# exclude-related mounts together in systemctl output.
#
# Examples:
#   (empty)                    /var/cache → var-cache.mount
#   SYSTEMD_UNIT_PREFIX=nosnap-  /var/cache → nosnap-var-cache.mount
#   SYSTEMD_UNIT_PREFIX=excl-    /var/cache → excl-var-cache.mount
#
# The unit's [Mount] Where= always points to the correct path regardless
# of the filename prefix.
#
# SYSTEMD_UNIT_PREFIX=

# --------------------------------------------------------------------------
# BTRFS_MOUNT_OPTS — Mount options for the subvolume
# --------------------------------------------------------------------------
# Comma-separated btrfs mount options applied to the new subvolume.
# The subvol= option is added automatically (do not include it here).
#
# Common options:
#   noatime       — don't update access time (performance)
#   compress=zstd — transparent compression (space saving)
#   nodatacow     — disable CoW (useful for databases, VMs)
#
BTRFS_MOUNT_OPTS="noatime,compress=zstd"

# --------------------------------------------------------------------------
# SNAPSHOT — Take a btrbk safety snapshot before making changes
# --------------------------------------------------------------------------
# When true (default), runs btrbk snapshot before creating the subvolume
# and copying data. Provides a recovery point in case something goes wrong.
#
# Set to false (or use --no-snapshot flag) when batch-excluding multiple
# paths in sequence — take ONE snapshot before the batch, then skip for each:
#
#   sudo btrbk snapshot raiz
#   sudo ./btrfs-exclude-path.sh /var/lib/apt/lists --no-snapshot
#   sudo ./btrfs-exclude-path.sh /var/crash --no-snapshot
#   sudo ./btrfs-exclude-path.sh /var/log/journal --no-snapshot
#
SNAPSHOT=true

# --------------------------------------------------------------------------
# BTRBK_MAP — Map mount points to btrbk snapshot_name for selective snapshots
# --------------------------------------------------------------------------
# By default, 'btrbk snapshot' snapshots ALL configured subvolumes.
# With BTRBK_MAP, only the affected subvolume is snapshotted.
#
# Format: bash associative array. Key = mount point, Value = btrbk snapshot_name.
# The script matches the target path to the longest matching mount point.
#
# Example (from btrbk.conf where subvolume @ has snapshot_name=raiz,
# and subvolume @home has snapshot_name=home):
#
#   declare -A BTRBK_MAP=(
#       [/]=raiz
#       [/home]=home
#   )
#
# With this config:
#   /var/lib/apt/lists → matches / → btrbk snapshot raiz (only @)
#   /home/downloads    → matches /home → btrbk snapshot home (only @home)
#
# If BTRBK_MAP is empty/unset, falls back to 'btrbk snapshot' (all).
#
# declare -A BTRBK_MAP=( [/]=raiz [/home]=home )
